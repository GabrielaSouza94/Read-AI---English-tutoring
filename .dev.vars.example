# Local secrets for `npm run dev`. Copy to .dev.vars (git-ignored) and fill in.
# Never put real values in this file: it is committed. See docs/SECRETS.md.
# Leave a value empty until its task needs it; /api/health then reports "config": "incomplete".

DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GEMINI_API_KEY=
LANGSMITH_API_KEY=
# Cloudflare's always-pass test keys for local development:
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HASH_SALT=
RESEND_API_KEY