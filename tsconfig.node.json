{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "react-router.config.ts",
    "e2e/**/*",
    "test/**/*",
    "scripts/**/*",
    // Runtime-neutral modules that Node scripts and integration tests import.
    "app/db/seed.ts",
    "app/db/seed-data.ts",
    "app/lib/password.ts",
    "app/db/schema.ts",
    "app/lib/alerts.ts",
    "app/lib/audit.ts",
    "app/lib/log.ts",
    "app/lib/metrics.ts",
    "app/lib/http.ts",
    "app/lib/langsmith.ts",
    "app/lib/mustache.ts",
    "app/lib/prompts.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
